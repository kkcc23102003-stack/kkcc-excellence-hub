# Supabase project settings for KKCC.
# Copy this file to .env.local (or your hosting provider env panel) and replace values.
# Public keys are safe for the browser; service-role key is server-only.

SUPABASE_PROJECT_ID="crrtkacxakinzpxcxbzf"
SUPABASE_URL="https://crrtkacxakinzpxcxbzf.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_7vdkIisIptgwy-7FkrTTLA_ZBAiewMK"

# Browser auth requires public values at build time. VITE_ and NEXT_PUBLIC_ are both supported.
VITE_SUPABASE_PROJECT_ID="crrtkacxakinzpxcxbzf"
VITE_SUPABASE_URL="https://crrtkacxakinzpxcxbzf.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_7vdkIisIptgwy-7FkrTTLA_ZBAiewMK"
NEXT_PUBLIC_SUPABASE_PROJECT_ID="crrtkacxakinzpxcxbzf"
NEXT_PUBLIC_SUPABASE_URL="https://crrtkacxakinzpxcxbzf.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_7vdkIisIptgwy-7FkrTTLA_ZBAiewMK"

# Optional legacy alias; supported for projects that still call the public key an anon key.
SUPABASE_ANON_KEY="sb_publishable_7vdkIisIptgwy-7FkrTTLA_ZBAiewMK"
VITE_SUPABASE_ANON_KEY="sb_publishable_7vdkIisIptgwy-7FkrTTLA_ZBAiewMK"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_7vdkIisIptgwy-7FkrTTLA_ZBAiewMK"

# Optional server-only key for future maintenance jobs. Never expose or commit this key.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional secret used by cron-auth.ts.
CRON_SECRET="replace-with-a-long-random-secret"
CRON_SECRET_PREVIOUS=""
