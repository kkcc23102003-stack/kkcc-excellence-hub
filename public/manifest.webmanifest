{
  "id": "/?source=pwa",
  "name": "KKCC-excellence-hub",
  "short_name": "KKCC",
  "description": "Kusum Kartik Coaching Centre learning platform for courses, tests, notes and lectures.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#050605",
  "theme_color": "#18f4d6",
  "orientation": "portrait-primary",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Continue Learning",
      "short_name": "Learn",
      "description": "Open your KKCC learning space.",
      "url": "/learn?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Courses",
      "short_name": "Courses",
      "description": "Open your enrolled courses.",
      "url": "/dashboard/courses?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Test Series",
      "short_name": "Tests",
      "description": "Open KKCC tests and practice.",
